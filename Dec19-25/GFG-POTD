class Solution {
  public:
    int findMoves(vector<int>& chairs, vector<int>& passengers) {
        // code here
        int n=chairs.size();
        sort(chairs.begin(),chairs.end());
        sort(passengers.begin(),passengers.end());
        int diff=0;
        int sum=0;
        for(int i=0;i<n;i++){
            diff = abs(chairs[i]-passengers[i]);
            sum=sum+diff;
        }
        return sum;
    }
};
