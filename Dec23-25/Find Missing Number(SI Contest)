#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        int total=0;
        int sum=0;
        for(int i=1;i<=n+1;i++){
            sum=sum+i;
        }
        vector<int> arr(n);
        for(int i=0;i<n;i++){
            cin >> arr[i];
        }
        for(int i=0;i<n;i++){
            total = total+arr[i];
        }
        cout << sum-total << endl;

    }
    
    
    return 0;
}
