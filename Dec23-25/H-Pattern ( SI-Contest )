#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int t;
    cin >> t;
    for(int i=1;i<=t;i++){
        cout << "Case #" << i << ":" << endl;
        int n,m;
        cin >> n >> m;

        for(int i=1;i<=n;i++){
            if(n%2==0 && i==n/2){
                for(int k=0;k<m;k++)
                    cout << "*";
                    
                }
           else if(n%2==1 && i==(n/2)+1){
                for(int k=0;k<m;k++)
                cout << "*";
            }
            else{
            for(int j=1;j<=m;j++){
                if(j==1 || j==m){
                    cout << "*";
                    
                }
                else{
                    cout << " ";
                }
                
            }
            }
            
           
            cout << endl;
        }
    }
    
    return 0;
}
