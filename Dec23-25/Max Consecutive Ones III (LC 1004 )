class Solution {
public:
    int longestOnes(vector<int>& arr, int k) {
        int n=arr.size();
        int l=0,r=0,zero=0,maxi=0,len=0;
        while(r<n){
            if(arr[r]==0)
            zero++;
            if(zero>k){
                if(arr[l]==0)
                zero--;
                l++;
            }
            if(zero<=k){
            len=r-l+1;
            maxi=max(maxi,len);
            }
            r++;
            
        }
        return maxi;
    }
};
