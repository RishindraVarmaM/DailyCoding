class Solution {
  public:
    void sortIt(vector<int>& arr) {
        // code here
        int n=arr.size();
        vector<int> odd;
        vector<int> even;
        
        sort(arr.begin(),arr.end());
        for(int i=0;i<n;i++){
        if(arr[i]%2==0){
            even.push_back(arr[i]);
        }
        else{
            odd.push_back(arr[i]);
        }
        }
        sort(odd.begin(),odd.end(),greater<int>());
        vector<int> result;
        for(int i=0;i<odd.size();i++){
            result.push_back(odd[i]);
        }
        
        for(int i=0;i<even.size();i++){
            result.push_back(even[i]);
        }
        arr=result;
        
       
        
    }
};
