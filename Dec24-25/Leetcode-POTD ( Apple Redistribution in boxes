class Solution {
public:
    int minimumBoxes(vector<int>& arr, vector<int>& capacity) {
        int n=arr.size();
        sort(capacity.begin(),capacity.end(),greater<int>());
        int sum=0;
        for(int i=0;i<n;i++){
            sum=sum+arr[i];
        }
        int c=0;
        for(int i=0;i<capacity.size();i++){
           
                sum=sum-capacity[i];
                c++;
            
            if(sum<=0){
                break;
            }
        }
        return c;

    }
};
