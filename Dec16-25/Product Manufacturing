#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */  
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        vector<long long> S(n);
        vector<long long> E(n);

        for(int i=0;i<n;i++){
            cin >> S[i] >> E[i];
        }
        sort(S.begin(),S.end());
        sort(E.begin(),E.end());

        int q;
        cin >> q;
        while(q--){
            long long id;
            cin >> id;
            int a=-1;
            int low=0;
            int high=n;
            while(low<high){
                int mid = (low+high)/2;
                if(S[mid]<=id){
                    
                    low=mid+1;
                }
                else{
                    high=mid;
                }
                a=low;
            }
            int b=-1;
            low=0;
            high=n;
            while(low<high){
               int mid = (low+high)/2;
                if(E[mid]<id){
                    
                    low=mid+1;
                }
                else{
                    high=mid;
                }
                b=low;
            }
            cout << a-b<< endl;

        }
       
    } 
    return 0;
}
