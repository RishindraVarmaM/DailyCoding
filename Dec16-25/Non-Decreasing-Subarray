#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */  
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        vector<long long>arr(n);
        for(int i=0;i<n;i++){
            cin >> arr[i];
        }
        long long count = 0;
        long long maxi=1;
        for(int i=0;i<n;i++){
            if(i==0){
                maxi=1;
            }
            else if(arr[i]>=arr[i-1]){
                maxi++;
            }
            else{
                maxi=1;
            }
            count+=maxi;
        
        }
        cout << count << endl;
        // *Note*
        // i am not supposed to print maxi cause its just the present count while the actual maximum count will be "count"
    } 
    return 0;
}
